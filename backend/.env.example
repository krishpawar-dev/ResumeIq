# ==============================================================================
# ResumeIQ Backend Environment Configuration Template
# Copy this file to .env and supply actual credentials before running.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# MongoDB Atlas Database
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/resumeiq?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# JWT Authentication & Security
# ------------------------------------------------------------------------------
# Generate a strong 64-char random string: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# ------------------------------------------------------------------------------
# OpenAI GPT API (Server-Side Only - Never Expose to Frontend)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Cloudinary File Storage (Resumes, Document Exports)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Redis Cache (For AI Response Caching & Distributed Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_URL=redis://default:password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# File Upload Limits
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_BYTES=5242880
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
